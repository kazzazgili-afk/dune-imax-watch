# Copy to config/secrets.env and fill in real values.
# config/secrets.env is gitignored - chmod 600 it once populated.
# A real environment variable with the same name always takes priority over this file.

DUNE_WATCH_NTFY_TOPIC=your-private-ntfy-topic-name

DUNE_WATCH_SMTP_USER=kazzazgili@gmail.com
