<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gilikazzaz.dune-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/gilikazzaz/dune-imax-watch/.venv/bin/python</string>
        <string>-m</string>
        <string>dune_watch</string>
        <string>run</string>
        <string>--loop</string>
        <string>--config</string>
        <string>/Users/gilikazzaz/dune-imax-watch/config/config.yaml</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/gilikazzaz/dune-imax-watch</string>

    <!-- A resident process, not a periodic one-shot.
         `run --once` polls every enabled venue unconditionally - it does NOT consult
         poll_interval_minutes - so the old StartInterval of 1200s was the real cadence
         and every per-venue interval in config.yaml was inert. Only `run --loop`
         schedules venues individually, which is what lets the mailboxes poll every
         2 minutes, the museum page every 5, and either drop to its hot cadence during
         an on-sale. KeepAlive restarts it if it dies or after a reboot. -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/gilikazzaz/Library/Logs/dune-watch/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gilikazzaz/Library/Logs/dune-watch/stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
