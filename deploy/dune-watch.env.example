# Copy to deploy/dune-watch.env on the server (gitignored) and fill in real values.
# Referenced by dune-watch.service's EnvironmentFile=.

DUNE_WATCH_NTFY_TOPIC=your-private-ntfy-topic-name

DUNE_WATCH_SMTP_USER=kazzazgili@gmail.com
DUNE_WATCH_SMTP_PASS=app-specific-password-here

DUNE_WATCH_IMAP_HOST=imap.gmail.com
DUNE_WATCH_IMAP_PORT=993
DUNE_WATCH_IMAP_USER=kazzazgili@gmail.com
# Use the SAME Gmail app password as DUNE_WATCH_SMTP_PASS above. A Gmail app password is
# 16 characters and works for both IMAP and SMTP. The local config/secrets.env had a
# 26-character value here that Gmail rejected with [AUTHENTICATIONFAILED], which silently
# disabled both mailbox venues on that machine - verify with:
#   python -m dune_watch run --once --venue bfi_imax
DUNE_WATCH_IMAP_PASS=app-specific-password-here
